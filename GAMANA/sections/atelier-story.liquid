{% liquid
  assign story_alt = section.settings.image.alt | default: section.settings.image_alt
%}

<section class="atelier-story{% if section.settings.image_position == 'right' %} atelier-story--image-right{% endif %}" aria-labelledby="AtelierStoryHeading-{{ section.id }}">
  <div class="atelier-story__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          class: 'atelier-story__image',
          widths: '540, 750, 1100, 1500, 1800',
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'lazy',
          alt: story_alt
      }}
    {% else %}
      <img
        class="atelier-story__image"
        src="{{ 'placeholder-garment.jpg' | asset_url }}"
        alt=""
        width="1024"
        height="1280"
        loading="lazy"
        decoding="async"
      >
    {% endif %}
  </div>
  <div class="atelier-story__content">
    <div class="atelier-story__content-inner">
      {% if section.settings.eyebrow != blank %}
        <p class="atelier-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 class="atelier-story__title" id="AtelierStoryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.body != blank %}
        <div class="atelier-story__body rte">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="atelier-text-link" href="{{ section.settings.link }}">
          {{ section.settings.link_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
      <span class="atelier-story__mark" aria-hidden="true">A.</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Atelier story",
  "tag": "section",
  "class": "atelier-story-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Story image" },
    { "type": "text", "id": "image_alt", "label": "Image description", "info": "Describe the image for shoppers using a screen reader. Leave blank if the image is only decorative." },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ]},
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A NOTE ON INTENTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to live with." },
    { "type": "richtext", "id": "body", "label": "Story", "default": "<p>We believe the things you reach for every day deserve a little more thought. A considered edit of pieces, textures and rituals — chosen to feel right now, and for a long time to come.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "A little about us" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [
    { "name": "Atelier story" }
  ]
}
{% endschema %}
