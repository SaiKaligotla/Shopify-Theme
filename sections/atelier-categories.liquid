<section class="atelier-categories page-width" aria-labelledby="AtelierCategoriesHeading-{{ section.id }}">
  <div class="atelier-categories__heading-row">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="atelier-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="AtelierCategoriesHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    {% if section.settings.link_label != blank and section.settings.link != blank %}
      <a class="atelier-text-link atelier-categories__all" href="{{ section.settings.link }}">
        {{ section.settings.link_label | escape }} <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  <div class="atelier-categories__grid">
    {% for block in section.blocks %}
      {% liquid
        assign category_alt = block.settings.image.alt | default: block.settings.image_alt
        assign fallback_asset = 'placeholder-garment.jpg'
        case forloop.index
          when 2
            assign fallback_asset = 'placeholder-serum.jpg'
          when 3
            assign fallback_asset = 'placeholder-bag.jpg'
        endcase
        assign category_link = block.settings.link | default: routes.all_products_collection_url
      %}
      <a class="atelier-category" href="{{ category_link }}" {{ block.shopify_attributes }}>
        <div class="atelier-category__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                class: 'atelier-category__image',
                widths: '420, 640, 840, 1200',
                sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw',
                loading: 'lazy',
                alt: category_alt
            }}
          {% else %}
            <img
              class="atelier-category__image"
              src="{{ fallback_asset | asset_url }}"
              alt=""
              width="1024"
              height="1280"
              loading="lazy"
              decoding="async"
            >
          {% endif %}
          <span class="atelier-category__arrow" aria-hidden="true">↗</span>
        </div>
        <div class="atelier-category__meta">
          <h3>{{ block.settings.title | escape }}</h3>
          {% if block.settings.subtitle != blank %}<span>{{ block.settings.subtitle | escape }}</span>{% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Atelier categories",
  "tag": "section",
  "class": "atelier-categories-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "FIND YOUR EVERYDAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your point of view." },
    { "type": "text", "id": "link_label", "label": "All collections link label", "default": "Shop everything" },
    { "type": "url", "id": "link", "label": "All collections link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Collection story",
      "settings": [
        { "type": "text", "id": "title", "label": "Collection name", "default": "The wardrobe" },
        { "type": "text", "id": "subtitle", "label": "Short description", "default": "Pieces to keep close" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image description" },
        { "type": "url", "id": "link", "label": "Collection link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Atelier categories",
      "blocks": [
        { "type": "category", "settings": { "title": "The wardrobe", "subtitle": "Pieces to keep close" } },
        { "type": "category", "settings": { "title": "Daily rituals", "subtitle": "A little care, every day" } },
        { "type": "category", "settings": { "title": "Finishing touches", "subtitle": "Small things, well chosen" } }
      ]
    }
  ]
}
{% endschema %}
