{% liquid
  assign hero_alt = section.settings.image.alt | default: section.settings.image_alt
  assign hero_fetch_priority = 'auto'
  assign hero_loading = 'lazy'
  if section.index == 1
    assign hero_fetch_priority = 'high'
    assign hero_loading = 'eager'
  endif
  assign primary_link = section.settings.primary_link | default: routes.all_products_collection_url
%}

<section
  class="atelier-hero{% if section.settings.text_color == 'light' %} atelier-hero--light{% endif %}"
  aria-labelledby="AtelierHeroHeading-{{ section.id }}"
>
  <div class="atelier-hero__media" aria-hidden="{% if section.settings.image != blank and hero_alt != blank %}false{% else %}true{% endif %}">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'atelier-hero__image',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: hero_loading,
          fetchpriority: hero_fetch_priority,
          alt: hero_alt
      }}
    {% else %}
      <img
        class="atelier-hero__image"
        src="{{ 'placeholder-editorial-hero.jpg' | asset_url }}"
        alt=""
        width="1586"
        height="992"
        loading="{{ hero_loading }}"
        fetchpriority="{{ hero_fetch_priority }}"
        decoding="async"
      >
    {% endif %}
  </div>
  <div class="atelier-hero__veil" aria-hidden="true"></div>
  <div class="atelier-hero__inner page-width">
    <div class="atelier-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="atelier-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if request.page_type == 'index' %}
        <h1 class="atelier-hero__title" id="AtelierHeroHeading-{{ section.id }}">
          <span>{{ section.settings.heading_line_1 | escape }}</span>
          <em>{{ section.settings.heading_line_2 | escape }}</em>
        </h1>
      {% else %}
        <h2 class="atelier-hero__title" id="AtelierHeroHeading-{{ section.id }}">
          <span>{{ section.settings.heading_line_1 | escape }}</span>
          <em>{{ section.settings.heading_line_2 | escape }}</em>
        </h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="atelier-hero__body">{{ section.settings.body | escape | newline_to_br }}</div>
      {% endif %}
      <div class="atelier-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="button button--primary atelier-button" href="{{ primary_link }}">
            <span>{{ section.settings.primary_label | escape }}</span>
            <span class="atelier-button__arrow" aria-hidden="true">↗</span>
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          <a class="atelier-text-link" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>
    <p class="atelier-hero__index" aria-hidden="true"><span>01</span> / THE NEW EDIT</p>
  </div>
</section>

{% schema %}
{
  "name": "Atelier hero",
  "tag": "section",
  "class": "atelier-hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "image_alt", "label": "Image description", "info": "Describe the image for shoppers using a screen reader. Leave blank if the image is only decorative." },
    { "type": "select", "id": "text_color", "label": "Text color", "default": "dark", "options": [
      { "value": "dark", "label": "Dark text (light image)" },
      { "value": "light", "label": "Light text (dark image)" }
    ]},
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "GAMANA / THE EVERYDAY EDIT" },
    { "type": "text", "id": "heading_line_1", "label": "Main heading — first line", "default": "A little less" },
    { "type": "text", "id": "heading_line_2", "label": "Main heading — second line", "default": "ordinary." },
    { "type": "textarea", "id": "body", "label": "Supporting text", "default": "Considered clothing, daily rituals and objects designed to make every day feel like yours." },
    { "type": "text", "id": "primary_label", "label": "Main button", "default": "Explore new arrivals" },
    { "type": "url", "id": "primary_link", "label": "Main button link" },
    { "type": "text", "id": "secondary_label", "label": "Second link label", "default": "Meet GAMANA" },
    { "type": "url", "id": "secondary_link", "label": "Second link" }
  ],
  "presets": [
    { "name": "Atelier hero" }
  ]
}
{% endschema %}
